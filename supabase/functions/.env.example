# Server-only configuration. Never prefix these with EXPO_PUBLIC_.
ROBOFLOW_API_KEY=replace-with-your-private-roboflow-api-key
# Workflow identifiers from the Universe deployment snippet.
ROBOFLOW_WORKSPACE=testing-workspace-3pknz
ROBOFLOW_WORKFLOW_ID=general-segmentation-api-2
# Optional: choose a named detection output if the workflow returns several.
# ROBOFLOW_WORKFLOW_OUTPUT_KEY=predictions
# Alternative: remove both workflow settings to use a trained detector directly.
# ROBOFLOW_MODEL_ID=your-trained-project/1
# Identification threshold, independent of any future alive/dead threshold.
ROBOFLOW_DETECTION_THRESHOLD=0.5
# Must match the deployed detector's lanternfly labels exactly (case-insensitive).
ROBOFLOW_CLASSES=Adult Spotted Lanternfly,Early Nymph Spotted Lanternfly,Late Nymph Spotted Lanternfly
