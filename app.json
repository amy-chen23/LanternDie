{
  "expo": {
    "name": "LanternDie",
    "slug": "lanterndie",
    "scheme": "lanterndie",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "LanternDie uses your photo library so you can choose lanternfly photos and a profile picture."
      },
      "bundleIdentifier": "com.hpatel2004.lanterndie"
    },
    "android": {
      "permissions": [
        "READ_MEDIA_IMAGES"
      ]
    },
    "plugins": [
      "onnxruntime-react-native",
      "expo-web-browser",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#f4f2e8"
        }
      ],
      "expo-asset",
      "expo-status-bar"
    ]
  }
}
