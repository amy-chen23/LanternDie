{
  "expo": {
    "name": "LanternDie",
    "slug": "lanterndie",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "splash": {
      "backgroundColor": "#f4f2e8"
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "LanternDie uses your photo library so you can choose a lanternfly photo to log."
      }
    },
    "android": {
      "permissions": [
        "READ_MEDIA_IMAGES"
      ]
    },
    "plugins": [
      "expo-status-bar"
    ]
  }
}
